# Python
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info/

# the environment of the workspace, made by `uv sync`
.venv/

# caches and reports of the tools
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Jupyter, e.g. the interactive window running the `# %%` scripts
.ipynb_checkpoints/

# the documentation site, built by docs/build_all.py
site/

# the results and figures of the simulations
.result/
.output/

# local files, never committed
.local/
.env

# editors and operating systems; the shared settings of VS Code are committed
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
