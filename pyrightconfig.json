// The type check of CI, `uv run pyright`, and of Pylance in VS Code, which reads this file too.
{
  "include": ["packages", "packages-dev", "apps", "docs"],
  "exclude": ["**/.*", "**/__pycache__", "site"],
  // the environment of `uv sync --all-packages`
  "venvPath": ".",
  "venv": ".venv",
  // the oldest supported version
  "pythonVersion": "3.11",
  "typeCheckingMode": "standard"
}
